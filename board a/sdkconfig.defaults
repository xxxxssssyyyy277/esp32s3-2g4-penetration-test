# Target chip
CONFIG_IDF_TARGET="esp32s3"

# Console on UART0, 115200 8N1
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# 1 ms tick: keep 50 ms keepalive and 2 s timeout easy to convert to ticks
CONFIG_FREERTOS_HZ=1000

# Pin the Wi-Fi driver task to core 1 (display task runs on core 0)
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y

# Protocol lines must stay clean: only "#..." and "[DISP] ..." at line start
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# Main/event task stacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

